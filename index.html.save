<!DOCTYPE html>
<html>
<head>
  <title>My Website</title>
  <style>
    body {
      background-color: #f9dfe7;
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      font-family: Arial, sans-serif;
      color: #000000;
    }

    .name {
      font-family: "Arial Black", Arial, sans-serif;
      font-size: 3rem;
      color: #000000;
      font-weight: 900;
      letter-spacing: 1px;
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="name">Sean Fairfield</div>
</body>
</html>
